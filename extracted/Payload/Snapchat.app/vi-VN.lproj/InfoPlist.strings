"NSBluetoothAlwaysUsageDescription" = "Điều này sẽ cho phép Snapchat kết nối với các phụ kiện Bluetooth như Kính Spectacles.";
"NSCameraUsageDescription" = "Dùng camera để chụp Snap, chơi với Ống Kính, và hơn thế nữa! Một vài Ống Kính có thể sử dụng tính năng camera TrueDepth của Apple. Đọc Chính Sách Bảo Mật của chúng tôi để biết thêm thông tin.";
"NSContactsUsageDescription" = "Danh bạ của bạn sẽ được tải lên máy chủ của Snapchat, nhờ đó bạn và tất cả mọi người có thể tìm bạn bè cũng như nâng cao trải nghiệm sử dụng.";
"NSLocalNetworkUsageDescription" = "Điều này sẽ cho phép Snapchat kết nối với các phụ kiện hỗ trợ Wi-Fi như Kính Spectacles.";
"NSLocationAlwaysAndWhenInUseUsageDescription" = "Khi bạn chọn “Luôn luôn”, Snap sẽ nhận được thông tin về vị trí của bạn ở chế độ nền. Vị trí được chia sẻ với Bạn bè trên Bản đồ Snap sẽ cập nhật theo “thời gian thực”.";
"NSLocationWhenInUseUsageDescription" = "Snapchat sử dụng tính năng này để tùy chỉnh trải nghiệm của bạn và cho phép bạn khám phá các bộ lọc, story xung quanh bạn và hơn thế nữa.";
"NSMicrophoneUsageDescription" = "Sử dụng micrô của bạn để thu âm cho Snap, chat video và hơn thế nữa.";
"NSMotionUsageDescription" = "Snapchat ghi lại xem thiết bị của bạn đặt dọc hay ngang khi bạn tạo Snap, sử dụng Ống kính, đọc phần Khám phá và xem quảng cáo.";
"NSPhotoLibraryAddUsageDescription" = "Cấp quyền truy cập thư viện ảnh để chia sẻ nội dung cuộn camera với bạn bè cũng như cá nhân hóa trải nghiệm của bạn trên Snapchat.";
"NSPhotoLibraryUsageDescription" = "Cấp quyền truy cập thư viện ảnh để chia sẻ nội dung cuộn camera với bạn bè cũng như cá nhân hóa trải nghiệm của bạn trên Snapchat.";
"NSUserTrackingUsageDescription" = "Khi bạn chọn “Cho Phép”, Snap có thể sẽ dần giảm bớt số lượng quảng cáo không liên quan hoặc lặp lại. Hãy xem Chính Sách Bảo Mật của chúng tôi để biết thêm thông tin về tính năng Theo Dõi.";