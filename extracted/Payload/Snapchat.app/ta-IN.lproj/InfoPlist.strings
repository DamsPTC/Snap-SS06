"NSBluetoothAlwaysUsageDescription" = "Spectacles போன்ற Bluetooth துணைக் கருவிகளுடன் Snapchat செயலியை இணைக்க இது அனுமதிக்கும்.";
"NSCameraUsageDescription" = "Snaps-ஐ எடுப்பதற்கு உங்கள் கேமராவைப் பயன்படுத்திடுங்கள், லென்ஸ்கள் கொண்டு விளையாடிடுங்கள், மேலும் இன்னும் பலவற்றைச் செய்திடுங்கள்! சில லென்ஸ்கள், Apple-இன் TrueDepth கேமராவைப் பயன்படுத்தலாம். மேலதிகத் தகவலுக்கு எங்கள் தனியுரிமைக் கொள்கையைக் காணுங்கள்.";
"NSContactsUsageDescription" = "உங்கள் அனுபவத்தை மேம்படுத்த Snapchat சேவையகங்களில் உங்கள் தொடர்புகள் பதிவேற்றப்படும். அத்துடன் நீங்களும் மற்றவர்களும் நண்பர்களைக் கண்டறியவும் இது உதவும்.";
"NSLocalNetworkUsageDescription" = "இது Spectacles போன்ற வைஃபை இயக்கப்பட்ட துணைக் கருவிகளுடன் Snapchat இது செயலியை இணைக்க அனுமதிக்கும்.";
"NSLocationAlwaysAndWhenInUseUsageDescription" = "'எப்போதும்' என்பதைத் தேர்ந்தெடுப்பது, உங்கள் இருப்பிடத்தைப் பின்னணியில் பெற Snapஐ அனுமதிக்கும். Snap மேப்பில் நண்பர்களுடன் பகிரப்பட்டுள்ள இருப்பிடம் 'நிகழ்நேரத்தில்' புதுப்பிக்கப்படும்.";
"NSLocationWhenInUseUsageDescription" = "Snapchat, உங்கள் அனுபவத்தைத் தனிப்பயனாக்க இதைப் பயன்படுத்துகிறது மற்றும் ஃபில்டர்கள், கதைகள் மற்றும் உங்களைச் சுற்றியுள்ள பலவற்றையும் ஆராய்ந்திட உங்களுக்கு வழிசெய்கிறது.";
"NSMicrophoneUsageDescription" = "Snaps-க்கான ஆடியோவைப் பதிவுசெய்ய, வீடியோ உரையாட மற்றும் பலவற்றிற்கு உங்கள் ஒலிவாங்கியைப் பயன்படுத்துங்கள்.";
"NSMotionUsageDescription" = "நீங்கள் Snap எடுக்கும்போதும், லென்ஸ்களைப் பயன்படுத்தும்போதும், 'கண்டறிக' இல் உள்ளவற்றைப் படிக்கும்போதும், விளம்பரங்களைப் பார்க்கும்போதும் உங்கள் சாதனம் செங்குத்தாக உள்ளதா அல்லது கிடைமட்டமாக உள்ளதா என்பதை Snapchat பதிவுசெய்கிறது.";
"NSPhotoLibraryAddUsageDescription" = "கேமராச் சுருள் உள்ளடக்கத்தை நண்பர்களுடன் பகிர்ந்துகொள்ளவும், Snapchat இல் உங்கள் அனுபவத்தைப் பிரத்தியேகமாக்கவும் புகைப்பட லைப்ரரிக்கான அணுகலை வழங்குங்கள்.";
"NSPhotoLibraryUsageDescription" = "கேமராச் சுருள் உள்ளடக்கத்தை நண்பர்களுடன் பகிர்ந்துகொள்ளவும், Snapchat இல் உங்கள் அனுபவத்தைப் பிரத்தியேகமாக்கவும் புகைப்பட லைப்ரரிக்கான அணுகலை வழங்குங்கள்.";
"NSUserTrackingUsageDescription" = "\"அனுமதி\" என்பதைத் தேர்ந்தெடுத்தால், காலப்போக்கில், பொருந்தாதவையாக அல்லது திரும்பத் திரும்ப தோன்றுபவையாக நீங்கள் கருதும் விளம்பரங்களை Snap குறைக்கலாம். கண்காணித்தல் பற்றிய கூடுதல் தகவல்களுக்கு, எங்கள் தனியுரிமைக் கொள்கையைப் பாருங்கள்.";