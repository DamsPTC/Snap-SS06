"NSBluetoothAlwaysUsageDescription" = "ಇದು Snapchat ಗೆ Spectacles ನಂತಹ bluetooth ಪರಿಕರಗಳೊಂದಿಗೆ ಸಂಪರ್ಕ ಸಾಧಿಸಲು ಅನುವು ಮಾಡಿಕೊಡುತ್ತದೆ.";
"NSCameraUsageDescription" = "Snapಗಳನ್ನು ತೆಗೆದುಕೊಳ್ಳಲು, ಲೆನ್ಸ್‌ಗಳೊಂದಿಗೆ ಆಟವಾಡಲು ಮತ್ತು ಇನ್ನಷ್ಟು ಮಾಡಲು ನಿಮ್ಮ ಕ್ಯಾಮೆರಾ ಬಳಸಿ! ಕೆಲವು ಲೆನ್ಸ್‌ಗಳು Apple ನ TrueDepth ಕ್ಯಾಮೆರಾವನ್ನು ಬಳಸಬಹುದು. ಹೆಚ್ಚಿನ ಮಾಹಿತಿಗಾಗಿ ನಮ್ಮ ಗೌಪ್ಯತೆ ನೀತಿಯನ್ನು ನೋಡಿ.";
"NSContactsUsageDescription" = "ನಿಮ್ಮ ಸಂಪರ್ಕಗಳನ್ನು Snapchat ನ ಸರ್ವರ್‌ಗಳಿಗೆ ಅಪ್‌ಲೋಡ್ ಮಾಡಲಾಗುತ್ತದೆ, ಇದರಿಂದ ನೀವು ಮತ್ತು ಇತರರು ಸ್ನೇಹಿತರನ್ನು ಹುಡುಕಬಹುದು ಮತ್ತು ನಿಮ್ಮ ಅನುಭವವನ್ನು ಸುಧಾರಿಸಿಕೊಳ್ಳಬಹುದು.";
"NSLocalNetworkUsageDescription" = "ಇದು Snapchat ಗೆ Spectacles ನಂತಹ Wi-Fi ಸಕ್ರಿಯಗೊಳಿಸಿದ ಪರಿಕರಗಳೊಂದಿಗೆ ಸಂಪರ್ಕ ಸಾಧಿಸಲು ಅನುವು ಮಾಡಿಕೊಡುತ್ತದೆ.";
"NSLocationAlwaysAndWhenInUseUsageDescription" = "'ಯಾವಾಗಲೂ' ಆಯ್ಕೆ ಮಾಡುವುದು Snap ಗೆ ನಿಮ್ಮ ಸ್ಥಳವನ್ನು ಹಿನ್ನೆಲೆಯಲ್ಲಿ ಪಡೆಯಲು ಸಮ್ಮತಿಸುತ್ತದೆ. Snap ಮ್ಯಾಪ್‌ನಲ್ಲಿ ಸ್ನೇಹಿತರೊಂದಿಗೆ ಹಂಚಿಕೊಂಡ ಸ್ಥಳ ʼನೈಜ-ಸಮಯದಲ್ಲಿʼ ಅಪ್‌ಡೇಟ್ ಆಗುತ್ತದೆ.";
"NSLocationWhenInUseUsageDescription" = "ನಿಮ್ಮ ಅನುಭವವನ್ನು ಕಸ್ಟಮೈಸ್ ಮಾಡಲು Snapchat ಇದನ್ನು ಬಳಸುತ್ತದೆ ಮತ್ತು ನಿಮ್ಮ ಸುತ್ತಲಿನ ಫಿಲ್ಟರ್‌ಗಳು, ಕಥೆಗಳು ಮತ್ತು ಹೆಚ್ಚಿನವನ್ನು ಕಂಡುಹಿಡಿಯಲು ನಿಮಗೆ ಅವಕಾಶ ಮಾಡಿಕೊಡುತ್ತದೆ.";
"NSMicrophoneUsageDescription" = "Snapಗಳು , ವೀಡಿಯೊ ಚಾಟ್ ಮುಂತಾದವುಗಳಿಗಾಗಿ ಆಡಿಯೊ ರೆಕಾರ್ಡ್ ಮಾಡಲು ನಿಮ್ಮ ಮೈಕ್ರೊಫೋನ್ ಬಳಸಿ.";
"NSMotionUsageDescription" = "ನೀವು Snap ಗಳನ್ನು ತೆಗೆದುಕೊಳ್ಳುವಾಗ, ಲೆನ್ಸ್‌ಗಳನ್ನು ಬಳಸುವಾಗ, Discover ಓದುವಾಗ ಮತ್ತು ಜಾಹೀರಾತುಗಳನ್ನು ವೀಕ್ಷಿಸುವಾಗ ನಿಮ್ಮ ಸಾಧನವು ಲಂಬ ಅಥವಾ ಸಮತಲವಾಗಿದೆಯೇ ಎಂಬುದನ್ನು Snapchat ರೆಕಾರ್ಡ್ ಮಾಡುತ್ತದೆ.";
"NSPhotoLibraryAddUsageDescription" = "ಕ್ಯಾಮೆರಾ ರೋಲ್ ಕಂಟೆಂಟ್ ಅನ್ನು ಸ್ನೇಹಿತರೊಂದಿಗೆ ಹಂಚಿಕೊಳ್ಳಲು ಮತ್ತು Snapchat ನಲ್ಲಿ ನಿಮ್ಮ ಅನುಭವವನ್ನು ವೈಯಕ್ತಿಕಗೊಳಿಸಲು, ಫೋಟೋ ಲೈಬ್ರರಿ ಆ್ಯಕ್ಸೆಸ್ ಒದಗಿಸಿ.";
"NSPhotoLibraryUsageDescription" = "ಕ್ಯಾಮೆರಾ ರೋಲ್ ಕಂಟೆಂಟ್ ಅನ್ನು ಸ್ನೇಹಿತರೊಂದಿಗೆ ಹಂಚಿಕೊಳ್ಳಲು ಮತ್ತು Snapchat ನಲ್ಲಿ ನಿಮ್ಮ ಅನುಭವವನ್ನು ವೈಯಕ್ತಿಕಗೊಳಿಸಲು, ಫೋಟೋ ಲೈಬ್ರರಿ ಆ್ಯಕ್ಸೆಸ್ ಒದಗಿಸಿ.";
"NSUserTrackingUsageDescription" = "\"ಅನುಮತಿಸಿ\" ಅನ್ನು ಟ್ಯಾಪ್ ಮಾಡುವ ಮೂಲಕ, ನಿಮಗೆ ಅಪ್ರಸ್ತುತ ಅಥವಾ ಕಾಲಕ್ರಮೇಣ ಪುನರಾವರ್ತಿತಗೊಳ್ಳುವ ಜಾಹೀರಾತುಗಳನ್ನು Snap ಕಡಿಮೆ ಮಾಡಬಹುದು. ಟ್ರ್ಯಾಕಿಂಗ್ ಕುರಿತು ಹೆಚ್ಚಿನ ಮಾಹಿತಿಗಾಗಿ ನಮ್ಮ ಗೌಪ್ಯತಾ ನೀತಿಯನ್ನು ನೋಡಿ.";