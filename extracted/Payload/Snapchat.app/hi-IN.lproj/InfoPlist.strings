"NSBluetoothAlwaysUsageDescription" = "इस तरह से, Snapchat, Spectacles जैसी Bluetooth ऐक्सेसरीज़ से जुड़ पाएगा।";
"NSCameraUsageDescription" = "Snaps लेने, लेंस का आनंद लेने और भी बहुत कुछ के लिए अपने कैमरे का उपयोग करें! कुछ लेंस हो सकता है कि Apple के TrueDepth कैमरे का उपयोग करें। अधिक जानकारी के लिए हमारी गोपनीयता नीति देखें।";
"NSContactsUsageDescription" = "आपके संपर्क Snapchat के सर्वरों पर अपलोड किए जाएंगे, ताकि आप और अन्य लोग फ़्रेंड्स को ढूंढ सकें और आपको बेहतर अनुभव दिया जा सके।";
"NSLocalNetworkUsageDescription" = "इस तरह से, Snapchat, Spectacles जैसी वाई-फ़ाई से चलने वाली ऐक्सेसरीज़ से जुड़ पाएगा।";
"NSLocationAlwaysAndWhenInUseUsageDescription" = "'हमेशा' विकल्प चुनने से Snap को बैकग्राउंड में आपकी लोकेशन पाने की अनुमति मिल जाएगी। Snap मैप पर फ़्रेंड्स के साथ शेयर की गई लोकेशन 'रियल-टाइम' में अपडेट होगी।";
"NSLocationWhenInUseUsageDescription" = "Snapchat आपका अनुभव आपके मुताबिक करने के लिए इसे उपयोग करता है ताकि आप फ़िल्टर, स्टोरीज़ व अपने आस-पास की अन्य चीजें डिस्कवर कर सकें।";
"NSMicrophoneUsageDescription" = "Snaps के लिए ऑडियो रिकॉर्ड करने, वीडियो चैट व अन्य कामों के लिए अपना माइक्रोफ़ोन उपयोग करें।";
"NSMotionUsageDescription" = "जब आप Snap बनाते हैं, लेंस का उपयोग करते हैं, डिस्कवर पढ़ते हैं और विज्ञापन देखते हैं, तो Snapchat रिकॉर्ड करता है कि आपकी डिवाइस वर्टिकल है या हॉरिज़ॉन्टल है।";
"NSPhotoLibraryAddUsageDescription" = "Snapchat पर फ़्रेंड्स के साथ अपना कैमरा रोल कॉन्टेंट शेयर करने और अपने अनुभव को व्यक्तिगत बनाने के लिए फ़ोटो लाइब्रेरी का ऐक्सेस दें।";
"NSPhotoLibraryUsageDescription" = "Snapchat पर फ़्रेंड्स के साथ अपना कैमरा रोल कॉन्टेंट शेयर करने और अपने अनुभव को व्यक्तिगत बनाने के लिए फ़ोटो लाइब्रेरी का ऐक्सेस दें।";
"NSUserTrackingUsageDescription" = "\"अनुमति दें\" चुनकर, Snap द्वारा भविष्य में आपके लिए अप्रासंगिक या बारबार दोहराए जाने वाले विज्ञापनों में कमी लाई जा सकती है। ट्रैकिंग के बारे में अधिक जानकारी के लिए हमारी गोपनीयता नीति देखें।";